    <title>Detail Buku | Perpustakaan Nusantara</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Georgia, "Times New Roman", serif;
            background: #f4efe5;
            color: #35291f;
        }

        /* ================= HEADER ================= */

        header {
            background: #3b2418;
            color: #f7ead3;
            padding: 20px 7%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 4px solid #b58b4b;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .logo-icon {
            font-size: 35px;
        }

        .logo h1 {
            font-size: 24px;
            letter-spacing: 1px;
        }

        .logo span {
            font-family: Arial, sans-serif;
            font-size: 11px;
            color: #d7bb86;
            display: block;
            margin-top: 3px;
        }

        nav {
            display: flex;
            gap: 25px;
        }

        nav a {
            color: #f7ead3;
            text-decoration: none;
            font-family: Arial, sans-serif;
            font-size: 14px;
        }

        nav a:hover {
            color: #d8b46a;
        }


        /* ================= BREADCRUMB ================= */

        .breadcrumb {
            width: 86%;
            max-width: 1200px;
            margin: 25px auto 0;

            font-family: Arial, sans-serif;
            font-size: 13px;
            color: #806d5d;
        }

        .breadcrumb a {
            color: #79502e;
            text-decoration: none;
        }


        /* ================= DETAIL ================= */

        .book-detail {
            width: 86%;
            max-width: 1200px;
            margin: 25px auto 60px;

            background: #fffaf1;

            border: 1px solid #d6c5a8;
            border-radius: 8px;

            padding: 45px;

            display: grid;
            grid-template-columns: 330px 1fr;

            gap: 55px;

            box-shadow: 0 8px 25px rgba(60, 40, 20, .10);
        }


        /* ================= COVER ================= */

        .book-cover {
            text-align: center;
        }

        .book-cover img {
            width: 280px;
            height: 400px;

            object-fit: cover;

            border-radius: 4px;

            box-shadow:
                0 8px 20px rgba(0,0,0,.25);

            transition: .3s;
        }

        .book-cover img:hover {
            transform: scale(1.02);
        }


        /* ================= BOOK INFO ================= */

        .category {
            display: inline-block;

            font-family: Arial, sans-serif;

            font-size: 11px;

            color: #9a7037;

            text-transform: uppercase;

            letter-spacing: 2px;

            margin-bottom: 12px;
        }

        .book-info h2 {
            font-size: 42px;

            font-weight: normal;

            color: #40291d;

            line-height: 1.15;

            margin-bottom: 10px;
        }

        .author {
            font-family: Arial, sans-serif;

            color: #75685d;

            font-size: 16px;

            margin-bottom: 18px;
        }

        .author strong {
            color: #4e392b;
        }


        /* ================= RATING ================= */

        .rating {
            display: flex;
            align-items: center;

            gap: 12px;

            margin-bottom: 25px;
        }

        .stars {
            color: #b28336;

            font-family: Arial, sans-serif;

            font-size: 20px;

            letter-spacing: 2px;
        }

        .rating-number {
            font-family: Arial, sans-serif;

            color: #67594d;

            font-size: 14px;
        }


        /* ================= DIVIDER ================= */

        .divider {
            width: 100%;

            height: 1px;

            background: #d8c8ae;

            margin: 20px 0 25px;
        }


        /* ================= SINOPSIS ================= */

        .description h3 {
            font-size: 22px;

            font-weight: normal;

            color: #4a2f20;

            margin-bottom: 12px;
        }

        .description p {
            font-family: Arial, sans-serif;

            font-size: 15px;

            line-height: 1.8;

            color: #5f534a;

            text-align: justify;
        }


        /* ================= BOOK DATA ================= */

        .book-data {
            display: grid;

            grid-template-columns: repeat(2, 1fr);

            gap: 12px 30px;

            margin-top: 25px;
        }

        .data-item {
            border-bottom: 1px solid #e0d3bf;

            padding: 10px 0;

            font-family: Arial, sans-serif;

            font-size: 13px;
        }

        .data-item span {
            display: block;

            color: #88786a;

            margin-bottom: 4px;
        }

        .data-item strong {
            color: #493529;
        }


        /* ================= BUTTON ================= */

        .actions {
            display: flex;

            gap: 12px;

            margin-top: 30px;
        }

        .btn {
            padding: 13px 25px;

            border-radius: 5px;

            text-decoration: none;

            font-family: Arial, sans-serif;

            font-size: 14px;

            cursor: pointer;

            border: none;
        }

        .btn-primary {
            background: #5a3824;

            color: white;
        }

        .btn-primary:hover {
            background: #3e2519;
        }

        .btn-secondary {
            border: 1px solid #9e8158;

            color: #65472f;

            background: transparent;
        }

        .btn-secondary:hover {
            background: #eee2cf;
        }


        /* ================= RELATED BOOKS ================= */

        .related {
            width: 86%;
            max-width: 1200px;

            margin: 0 auto 70px;
        }

        .related-title {
            text-align: center;

            margin-bottom: 30px;
        }

        .related-title h2 {
            font-size: 30px;

            font-weight: normal;

            color: #4a2f20;
        }

        .ornament {
            color: #b58b4b;

            font-size: 22px;

            margin-top: 8px;
        }

        .related-grid {
            display: grid;

            grid-template-columns: repeat(4, 1fr);

            gap: 22px;
        }

        .related-card {
            background: #fffaf1;

            border: 1px solid #d6c5a8;

            border-radius: 6px;

            overflow: hidden;

            transition: .3s;
        }

        .related-card:hover {
            transform: translateY(-5px);

            box-shadow: 0 8px 20px rgba(60,40,20,.12);
        }

        .related-card img {
            width: 100%;

            height: 240px;

            object-fit: cover;
        }

        .related-info {
            padding: 15px;
        }

        .related-info h3 {
            font-size: 17px;

            margin-bottom: 5px;
        }

        .related-info p {
            font-family: Arial, sans-serif;

            color: #776b61;

            font-size: 12px;
        }


        /* ================= FOOTER ================= */

        footer {
            background: #3b2418;

            color: #e9dcc7;

            padding: 40px 7%;

            text-align: center;
        }

        footer h3 {
            font-size: 22px;

            font-weight: normal;

            margin-bottom: 10px;
        }

        footer p {
            font-family: Arial, sans-serif;

            font-size: 13px;

            color: #cdbda5;
        }


        /* ================= RESPONSIVE ================= */

        @media (max-width: 900px) {

            .book-detail {
                grid-template-columns: 1fr;

                text-align: center;

                padding: 30px;
            }

            .book-cover img {
                width: 250px;

                height: 360px;
            }

            .rating {
                justify-content: center;
            }

            .book-data {
                text-align: left;
            }

            .actions {
                justify-content: center;
            }

            .related-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            nav {
                display: none;
            }
        }


        @media (max-width: 500px) {

            .book-detail {
                width: 94%;

                padding: 20px;
            }

            .book-info h2 {
                font-size: 32px;
            }

            .book-cover img {
                width: 210px;

                height: 310px;
            }

            .book-data {
                grid-template-columns: 1fr;
            }

            .actions {
                flex-direction: column;
            }

            .btn {
                text-align: center;
            }

            .related-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>


